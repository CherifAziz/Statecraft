.app-root {
    flex-grow: 1;
    color: #ece7dc;
}

.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-grow: 1;
}

.boot-screen {
    align-items: center;
    justify-content: center;
    background-color: #080b0f;
}

.boot-frame {
    width: 58%;
    min-width: 660px;
    max-width: 1120px;
    min-height: 500px;
    align-items: center;
    justify-content: center;
    padding: 72px;
    background-color: #10151a;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: #3b4247;
    border-right-color: #3b4247;
    border-top-color: #3b4247;
    border-bottom-color: #3b4247;
}

.eyebrow {
    font-size: 12px;
    letter-spacing: 3px;
    color: #9da7ae;
    -unity-font-style: bold;
}

.boot-title {
    margin-top: 22px;
    font-size: 72px;
    letter-spacing: 12px;
    color: #f1ede3;
    -unity-font-style: bold;
}

.boot-subtitle {
    margin-top: 16px;
    font-size: 19px;
    letter-spacing: 2px;
    color: #aeb5b8;
}

.boot-rule {
    width: 76px;
    height: 2px;
    margin-top: 42px;
    margin-bottom: 42px;
    background-color: #c7a968;
}

.primary-button {
    height: 52px;
    padding-left: 30px;
    padding-right: 30px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-radius: 0;
    background-color: #d5b96e;
    border-left-color: #ead28f;
    border-right-color: #ead28f;
    border-top-color: #ead28f;
    border-bottom-color: #ead28f;
    color: #121417;
    font-size: 12px;
    letter-spacing: 2px;
    -unity-font-style: bold;
}

.primary-button:hover {
    opacity: 0.85;
}

.primary-button:disabled {
    opacity: 0.3;
}

.build-label {
    position: absolute;
    right: 34px;
    bottom: 26px;
    font-size: 10px;
    letter-spacing: 2px;
    color: #626b70;
}

.map-screen {
    background-color: #050a0f;
}

.world-map-header {
    min-height: 104px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 42px;
    padding-right: 42px;
    border-bottom-width: 1px;
    border-bottom-color: #24313a;
}

.world-map-brand-title {
    font-size: 24px;
    letter-spacing: 6px;
    color: #eee9dc;
    -unity-font-style: bold;
}

.world-map-brand-subtitle {
    margin-top: 6px;
    font-size: 10px;
    letter-spacing: 3px;
    color: #9b8a66;
}

.world-map-source-label {
    font-size: 9px;
    letter-spacing: 1.8px;
    color: #687781;
}

.world-map-body {
    flex-grow: 1;
    min-height: 0;
    flex-direction: row;
    padding-left: 34px;
    padding-right: 34px;
    padding-top: 24px;
    padding-bottom: 30px;
}

.world-map-panel {
    flex-grow: 1;
    min-width: 0;
    margin-right: 24px;
    background-color: #081017;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: #263640;
    border-right-color: #263640;
    border-top-color: #263640;
    border-bottom-color: #263640;
}

.world-map-toolbar {
    min-height: 66px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 22px;
    padding-right: 22px;
    border-bottom-width: 1px;
    border-bottom-color: #1d2b34;
}

.world-map-title-block {
    justify-content: center;
}

.world-map-eyebrow {
    font-size: 9px;
    letter-spacing: 2.4px;
    color: #b79a61;
}

.world-map-count {
    margin-top: 6px;
    font-size: 10px;
    letter-spacing: 1.4px;
    color: #718089;
}

.world-map-hover-label {
    font-size: 10px;
    letter-spacing: 1.6px;
    color: #c2b596;
}

.world-map-view {
    position: relative;
    flex-grow: 1;
    min-height: 560px;
    overflow: hidden;
    background-color: #050a0f;
}

.world-map-geometry {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    transform-origin: left top;
}

.world-map-debug {
    position: absolute;
    left: 14px;
    top: 14px;
    padding: 10px;
    background-color: rgba(2, 5, 8, 0.88);
    color: #d5c8aa;
    font-size: 10px;
    white-space: normal;
}

.world-map-footer {
    min-height: 54px;
    flex-direction: row;
    align-items: center;
    padding-left: 20px;
    padding-right: 20px;
    border-top-width: 1px;
    border-top-color: #1d2b34;
}

.world-map-legend-item {
    margin-right: 22px;
    flex-direction: row;
    align-items: center;
}

.world-map-legend-swatch {
    width: 9px;
    height: 9px;
    margin-right: 8px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(238, 232, 215, 0.28);
    border-right-color: rgba(238, 232, 215, 0.28);
    border-top-color: rgba(238, 232, 215, 0.28);
    border-bottom-color: rgba(238, 232, 215, 0.28);
}

.world-map-legend-swatch--available {
    background-color: #2b3d47;
}

.world-map-legend-swatch--unavailable {
    background-color: #18252e;
}

.world-map-legend-swatch--selected {
    background-color: #8a7449;
}

.world-map-legend-text {
    font-size: 8px;
    letter-spacing: 1.5px;
    color: #7b898f;
}

.world-map-controls {
    flex-grow: 1;
    font-size: 8px;
    letter-spacing: 1.2px;
    color: #5f6d76;
    -unity-text-align: middle-right;
}

.world-map-country-panel {
    width: 326px;
    min-width: 326px;
    padding-left: 30px;
    padding-right: 30px;
    padding-top: 38px;
    padding-bottom: 30px;
    background-color: #0b1218;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: #263640;
    border-right-color: #263640;
    border-top-color: #263640;
    border-bottom-color: #263640;
}

.world-map-selection-name {
    margin-top: 18px;
    min-height: 76px;
    font-size: 31px;
    color: #eee9dc;
    white-space: normal;
    -unity-font-style: bold;
}

.world-map-selection-rule {
    width: 54px;
    height: 1px;
    margin-top: 4px;
    margin-bottom: 34px;
    background-color: #967d4c;
}

.world-map-selection-details {
    flex-grow: 1;
}

.world-map-selection-row {
    margin-bottom: 26px;
}

.world-map-selection-key {
    font-size: 8px;
    letter-spacing: 2px;
    color: #61717b;
}

.world-map-selection-value {
    margin-top: 7px;
    font-size: 17px;
    color: #d8d2c4;
    white-space: normal;
}

.world-map-incarnate-button {
    min-height: 52px;
    border-radius: 0;
    font-size: 10px;
    letter-spacing: 3px;
    -unity-font-style: bold;
}

.compact .boot-title {
    font-size: 52px;
}

.compact .world-map-header {
    min-height: 88px;
    padding-left: 24px;
    padding-right: 24px;
}

.compact .world-map-body {
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 18px;
    padding-bottom: 22px;
}

.compact .world-map-panel {
    margin-right: 16px;
}

.compact .world-map-country-panel {
    width: 280px;
    min-width: 280px;
    padding-left: 22px;
    padding-right: 22px;
}

.compact .world-map-controls {
    display: none;
}
