/* Root and background layers */
.leader-screen {
    overflow: hidden;
    background-color: #050a0f;
}

.leader-background-artwork,
.leader-ambient-light,
.leader-surface-texture,
.leader-foreground-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-repeat: no-repeat;
    background-position: center;
    background-size: cover;
}

.leader-background-artwork {
    left: -8px;
    right: -8px;
    top: -8px;
    bottom: -8px;
    opacity: 0.72;
    transform-origin: center;
}

.leader-ambient-light {
    opacity: 0;
}

.leader-surface-texture {
    opacity: 0.01;
    background-repeat: repeat;
    background-size: 720px 720px;
}

.leader-foreground-overlay {
    opacity: 0.1;
    background-size: contain;
}

/* Reusable dividers and corners */
.leader-divider {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.leader-divider-line {
    height: 1px;
    flex-grow: 1;
    opacity: 0.4;
}

.leader-divider-artwork {
    width: 146px;
    height: 9px;
    flex-shrink: 0;
    margin-left: 10px;
    margin-right: 10px;
    background-repeat: no-repeat;
    background-position: center;
    background-size: contain;
}

.leader-divider-fallback {
    width: 6px;
    height: 6px;
    flex-shrink: 0;
    margin-left: 10px;
    margin-right: 10px;
    rotate: 45deg;
    opacity: 0.72;
}

.leader-corner-set {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.leader-corner {
    position: absolute;
    width: 34px;
    height: 32px;
    opacity: 0.6;
    background-repeat: no-repeat;
    background-position: left top;
    background-size: contain;
}

.leader-corner--top-left {
    left: 12px;
    top: 12px;
}

.leader-corner--top-right {
    right: 12px;
    top: 12px;
    scale: -1 1;
}

.leader-corner--bottom-left {
    left: 12px;
    bottom: 12px;
    scale: 1 -1;
}

.leader-corner--bottom-right {
    right: 12px;
    bottom: 12px;
    scale: -1 -1;
}

.leader-corner-fallback-horizontal,
.leader-corner-fallback-vertical {
    position: absolute;
    left: 0;
    top: 0;
}

.leader-corner-fallback-horizontal {
    width: 26px;
    height: 1px;
}

.leader-corner-fallback-vertical {
    width: 1px;
    height: 26px;
}

.leader-corner-set--hero .leader-corner--artwork {
    width: 54px;
    height: 50px;
    opacity: 0.7;
}

.leader-corner-set--panel .leader-corner--artwork {
    width: 31px;
    height: 29px;
    opacity: 0.46;
}

/* Header */
.leader-header {
    min-height: 108px;
    flex-shrink: 0;
    justify-content: center;
    border-bottom-width: 0;
}

.leader-header-content {
    width: 100%;
    max-width: 1920px;
    height: 100%;
    align-self: center;
    flex-direction: row;
    align-items: center;
    padding-left: 2.6%;
    padding-right: 2.6%;
}

.leader-country-identity {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.leader-emblem {
    width: 74px;
    height: 74px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    opacity: 0.72;
    background-repeat: no-repeat;
    background-position: center;
    background-size: contain;
}

.leader-emblem-fallback {
    width: 48px;
    height: 48px;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.2);
    border-right-color: rgba(255, 255, 255, 0.2);
    border-top-color: rgba(255, 255, 255, 0.2);
    border-bottom-color: rgba(255, 255, 255, 0.2);
    font-size: 10px;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    -unity-font-style: normal;
}

.leader-country-separator {
    width: 1px;
    height: 60px;
    flex-shrink: 0;
    margin-left: 18px;
    margin-right: 22px;
    opacity: 0.42;
}

.leader-country-name {
    font-size: 34px;
    letter-spacing: 4.2px;
    -unity-font-style: normal;
}

.leader-country-meta {
    margin-top: 4px;
    font-size: 11px;
    letter-spacing: 1.4px;
    opacity: 0.96;
    -unity-font-style: normal;
}

.leader-country-rule {
    height: 10px;
    flex-grow: 1;
    margin-left: 34px;
    margin-right: 34px;
}

.leader-country-rule .leader-divider-line {
    opacity: 0.48;
}

.back-button {
    height: 46px;
    min-width: 208px;
    flex-shrink: 0;
    padding-left: 14px;
    padding-right: 14px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 2px;
    border-radius: 0;
    font-size: 12px;
    letter-spacing: 1.9px;
    opacity: 1;
    -unity-font-style: normal;
    transition-property: opacity, scale, translate;
    transition-duration: 170ms;
    transition-timing-function: ease-out;
}

.back-button:hover {
    opacity: 0.86;
    translate: -3px 0;
}

.back-button:active {
    opacity: 0.68;
    scale: 0.986;
    translate: -1px 1px;
}

/* Main composition */
.leader-stage {
    width: 100%;
    max-width: 1920px;
    flex-grow: 1;
    min-height: 0;
    align-self: center;
    flex-direction: row;
    padding-left: 2.6%;
    padding-right: 2.6%;
    padding-top: 12px;
    padding-bottom: 28px;
}

/* Hero portrait */
.leader-visual-column {
    width: 40%;
    min-width: 540px;
    max-width: 780px;
    height: 100%;
    margin-right: 0;
}

.portrait-stage {
    position: relative;
    flex-grow: 1;
    min-height: 720px;
    overflow: hidden;
    background-color: rgba(1, 4, 7, 0.04);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.portrait-artwork,
.portrait-frame,
.portrait-ornament {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-repeat: no-repeat;
}

.portrait-artwork {
    left: -40px;
    right: -4px;
    top: -8px;
    bottom: -8px;
    background-size: contain;
    background-position: center bottom;
    opacity: 0;
    translate: 0 8px;
    transition-property: opacity, translate;
    transition-duration: 360ms;
    transition-timing-function: ease-out;
}

.portrait-artwork--visible {
    opacity: 1;
    translate: 0 0;
}

.portrait-frame {
    margin: 8px;
    background-size: contain;
    background-position: center;
    opacity: 0.28;
}

.portrait-ornament {
    left: 23%;
    right: 23%;
    top: 12%;
    bottom: 25%;
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    opacity: 0.06;
}

.portrait-monogram {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 28%;
    align-items: center;
    justify-content: center;
    font-size: 112px;
    letter-spacing: 14px;
    opacity: 0.4;
    -unity-text-align: middle-center;
    -unity-font-style: normal;
}

/* Leader identity */
.leader-identity {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 41%;
    min-height: 330px;
    justify-content: flex-end;
}

.leader-identity-gradient {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.leader-identity-ornament {
    position: absolute;
    left: 34px;
    right: 34px;
    top: 98px;
    height: 34px;
}

.leader-identity-ornament .leader-divider-line {
    opacity: 0.34;
}

.leader-identity-ornament .leader-divider-artwork {
    width: 176px;
    height: 36px;
    margin-left: 12px;
    margin-right: 12px;
}

.leader-identity-copy {
    flex-grow: 1;
    align-items: center;
    justify-content: flex-start;
    padding-left: 30px;
    padding-right: 30px;
    padding-top: 130px;
    padding-bottom: 30px;
}

.leader-name {
    font-size: 49px;
    letter-spacing: 1.6px;
    white-space: normal;
    -unity-text-align: middle-center;
    -unity-font-style: normal;
}

.leader-title {
    margin-top: 13px;
    font-size: 22px;
    letter-spacing: 0.35px;
    opacity: 1;
    -unity-text-align: middle-center;
    -unity-font-style: normal;
}

.leader-function {
    margin-top: 21px;
    font-size: 10px;
    letter-spacing: 3.5px;
    opacity: 0.94;
    -unity-text-align: middle-center;
    -unity-font-style: normal;
}

/* Editorial panel */
.leader-editorial-panel {
    position: relative;
    flex-grow: 1;
    min-width: 0;
    height: 100%;
    min-height: 720px;
    margin-left: 0;
    overflow: hidden;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
}

.leader-editorial-backdrop,
.leader-editorial-texture {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.leader-editorial-texture {
    opacity: 0.01;
    background-repeat: repeat;
    background-size: 720px 720px;
}

.leader-editorial-content {
    flex-grow: 1;
    padding-left: 44px;
    padding-right: 44px;
    padding-top: 30px;
    padding-bottom: 28px;
}

.leader-stats-section,
.leader-skills-section,
.editorial-heading {
    flex-shrink: 0;
}

.editorial-heading .eyebrow {
    font-size: 11px;
    letter-spacing: 1.8px;
    -unity-font-style: normal;
}

.editorial-title {
    margin-top: 7px;
    letter-spacing: 0.35px;
    -unity-font-style: normal;
}

.editorial-heading--stats .editorial-title {
    font-size: 46px;
}

.editorial-heading--skills .editorial-title {
    font-size: 40px;
}

.editorial-title-rule {
    height: 10px;
    margin-top: 8px;
}

.editorial-heading--stats .editorial-title-rule {
    width: 286px;
}

.editorial-heading--skills .editorial-title-rule {
    width: 324px;
}

.editorial-title-rule .leader-divider-artwork {
    width: 112px;
    height: 7px;
    margin-left: 7px;
    margin-right: 7px;
}

.editorial-title-rule .leader-divider-line {
    opacity: 0.36;
}

.editorial-section-divider {
    width: 100%;
    height: 1px;
    flex-shrink: 0;
    margin-top: 22px;
    margin-bottom: 18px;
    opacity: 0.28;
}

/* Stats */
.stats-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    padding-top: 2px;
}

.stat-row {
    width: 47.8%;
    min-height: 61px;
    margin-top: 21px;
    flex-direction: row;
    align-items: center;
}

.stat-icon-frame {
    position: relative;
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    margin-right: 17px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-radius: 50%;
}

.stat-icon-frame--artwork {
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.stat-icon-artwork {
    position: absolute;
    left: 1px;
    right: 1px;
    top: 1px;
    bottom: 1px;
    background-repeat: no-repeat;
    background-position: center;
    background-size: contain;
}

.stat-icon {
    font-size: 9px;
    letter-spacing: 0.8px;
    -unity-text-align: middle-center;
    -unity-font-style: normal;
}

.stat-body {
    flex-grow: 1;
    min-width: 0;
}

.stat-heading {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
}

.stat-name {
    font-size: 11px;
    letter-spacing: 1.5px;
    opacity: 0.98;
    -unity-font-style: normal;
}

.stat-value {
    width: 32px;
    font-size: 17px;
    opacity: 1;
    -unity-text-align: middle-right;
    -unity-font-style: normal;
}

.stat-track {
    height: 4px;
    overflow: visible;
    background-color: rgba(255, 255, 255, 0.13);
}

.stat-fill {
    position: relative;
    height: 4px;
}

.stat-marker {
    position: absolute;
    right: -4px;
    top: -2px;
    width: 8px;
    height: 8px;
    rotate: 45deg;
}

/* Skills */
.leader-skill-grid {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 16px;
}

.leader-skill-card {
    position: relative;
    width: 23.7%;
    height: 350px;
    flex-shrink: 0;
    align-items: stretch;
    padding: 4px;
    overflow: hidden;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-radius: 0;
    transition-property: scale, opacity, background-color, border-left-color, border-right-color, border-top-color, border-bottom-color;
    transition-duration: 180ms;
    transition-timing-function: ease-out;
}

.leader-skill-card--hovered {
    scale: 1.006;
}

.leader-skill-card--selected {
    scale: 1.002;
}

.leader-skill-card:active {
    scale: 0.996;
    opacity: 0.86;
}

.leader-skill-card--locked {
    opacity: 0.68;
}

.leader-skill-card--locked:hover {
    scale: 1;
}

.skill-artwork {
    position: relative;
    height: 180px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-repeat: no-repeat;
    background-position: center;
    background-size: cover;
}

.skill-artwork-placeholder {
    font-size: 30px;
    opacity: 0.46;
    -unity-text-align: middle-center;
}

.skill-lock-indicator {
    position: absolute;
    right: 9px;
    top: 9px;
    width: 26px;
    height: 30px;
    align-items: center;
    justify-content: flex-end;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    background-color: rgba(3, 6, 9, 0.9);
}

.skill-lock-shackle {
    position: absolute;
    left: 7px;
    right: 7px;
    top: 5px;
    height: 10px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
}

.skill-lock-body {
    width: 11px;
    height: 9px;
    margin-bottom: 5px;
}

.skill-card-body {
    flex-grow: 1;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 15px;
    padding-bottom: 12px;
}

.skill-card-name {
    min-height: 31px;
    font-size: 17px;
    letter-spacing: 0.2px;
    white-space: normal;
    -unity-font-style: normal;
}

.skill-card-header {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 9px;
}

.skill-type,
.skill-state {
    font-size: 11px;
    letter-spacing: 0.9px;
    opacity: 0.98;
    -unity-font-style: normal;
}

.skill-description {
    height: 48px;
    margin-top: 12px;
    font-size: 12px;
    white-space: normal;
    overflow: hidden;
    opacity: 0.92;
    -unity-font-style: normal;
}

.skill-card-spacer {
    flex-grow: 1;
}

.skill-accent-line {
    width: 34px;
    height: 1px;
    margin-top: 8px;
    transition-property: width, background-color;
    transition-duration: 180ms;
    transition-timing-function: ease-out;
}

.leader-skill-card--hovered .skill-accent-line {
    width: 52px;
}

.leader-skill-card--selected .skill-accent-line {
    width: 76%;
}

/* Short desktop */
.short-desktop .leader-header {
    min-height: 90px;
}

.short-desktop .leader-emblem {
    width: 62px;
    height: 62px;
}

.short-desktop .leader-country-separator {
    height: 44px;
}

.short-desktop .leader-country-name {
    font-size: 27px;
}

.short-desktop .leader-stage {
    padding-top: 8px;
    padding-bottom: 14px;
}

.short-desktop .portrait-stage,
.short-desktop .leader-editorial-panel {
    min-height: 680px;
}

.short-desktop .leader-identity {
    min-height: 268px;
}

.short-desktop .leader-identity-copy {
    padding-top: 86px;
    padding-bottom: 23px;
}

.short-desktop .leader-identity-ornament {
    top: 34px;
}

.short-desktop .leader-name {
    font-size: 40px;
}

.short-desktop .leader-title {
    font-size: 18px;
}

.short-desktop .leader-function {
    margin-top: 12px;
}

.short-desktop .leader-editorial-content {
    padding-top: 22px;
    padding-bottom: 18px;
}

.short-desktop .editorial-heading--stats .editorial-title {
    font-size: 36px;
}

.short-desktop .editorial-heading--skills .editorial-title {
    font-size: 32px;
}

.short-desktop .editorial-title-rule {
    margin-top: 6px;
}

.short-desktop .editorial-section-divider {
    margin-top: 16px;
    margin-bottom: 13px;
}

.short-desktop .stat-row {
    min-height: 46px;
    margin-top: 12px;
}

.short-desktop .stat-icon-frame {
    width: 34px;
    height: 34px;
    margin-right: 12px;
}

.short-desktop .stat-heading {
    margin-bottom: 8px;
}

.short-desktop .leader-skill-grid {
    margin-top: 12px;
}

.short-desktop .leader-skill-card {
    height: 264px;
}

.short-desktop .skill-artwork {
    height: 128px;
}

.short-desktop .skill-card-body {
    padding-left: 11px;
    padding-right: 11px;
    padding-top: 8px;
    padding-bottom: 7px;
}

.short-desktop .skill-card-name {
    min-height: 25px;
    font-size: 14px;
}

.short-desktop .skill-type,
.short-desktop .skill-state {
    font-size: 8px;
}

.short-desktop .skill-description {
    height: 35px;
    margin-top: 7px;
    font-size: 9px;
}

/* Compact desktop */
.compact .leader-header {
    min-height: 86px;
}

.compact .leader-header-content {
    padding-left: 2.2%;
    padding-right: 2.2%;
}

.compact .leader-emblem {
    width: 52px;
    height: 52px;
}

.compact .leader-country-separator {
    height: 42px;
    margin-left: 13px;
    margin-right: 14px;
}

.compact .leader-country-name {
    font-size: 24px;
}

.compact .leader-country-meta {
    font-size: 9px;
    letter-spacing: 1.2px;
}

.compact .leader-country-rule {
    margin-left: 18px;
    margin-right: 18px;
}

.compact .leader-divider-artwork {
    width: 96px;
    height: 6px;
}

.compact .back-button {
    min-width: 166px;
    font-size: 11px;
}

.compact .leader-stage {
    padding-left: 2.2%;
    padding-right: 2.2%;
    padding-top: 8px;
    padding-bottom: 16px;
}

.compact .leader-visual-column {
    width: 39%;
    min-width: 430px;
    max-width: 600px;
}

.compact .portrait-stage,
.compact .leader-editorial-panel {
    min-height: 640px;
}

.compact .leader-identity {
    min-height: 250px;
}

.compact .leader-identity-ornament {
    top: 42px;
}

.compact .leader-identity-copy {
    padding-left: 22px;
    padding-right: 22px;
    padding-top: 105px;
    padding-bottom: 22px;
}

.compact .leader-name {
    font-size: 36px;
}

.compact .leader-title {
    font-size: 17px;
}

.compact .leader-function {
    margin-top: 12px;
    font-size: 9px;
}

.compact .leader-editorial-content {
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 22px;
    padding-bottom: 18px;
}

.compact .editorial-heading--stats .editorial-title {
    font-size: 34px;
}

.compact .editorial-heading--skills .editorial-title {
    font-size: 30px;
}

.compact .editorial-title-rule {
    margin-top: 6px;
}

.compact .editorial-section-divider {
    margin-top: 15px;
    margin-bottom: 13px;
}

.compact .stat-row {
    min-height: 45px;
    margin-top: 13px;
}

.compact .stat-icon-frame {
    width: 32px;
    height: 32px;
    margin-right: 10px;
}

.compact .stat-heading {
    margin-bottom: 8px;
}

.compact .stat-name {
    font-size: 9px;
}

.compact .stat-value {
    font-size: 14px;
}

.compact .stat-track,
.compact .stat-fill {
    height: 3px;
}

.compact .stat-marker {
    right: -3px;
    top: -2px;
    width: 7px;
    height: 7px;
}

.compact .leader-skill-grid {
    margin-top: 12px;
}

.compact .leader-skill-card {
    height: 250px;
    padding: 4px;
}

.compact .skill-artwork {
    height: 118px;
}

.compact .skill-card-body {
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 8px;
    padding-bottom: 7px;
}

.compact .skill-card-name {
    min-height: 24px;
    font-size: 13px;
}

.compact .skill-type,
.compact .skill-state {
