/* Root and art layers */
.leader-screen {
    overflow: hidden;
    background-color: #090a09;
}

.leader-background-artwork,
.leader-ambient-light,
.leader-surface-texture,
.leader-foreground-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-repeat: no-repeat;
    background-position: center;
    background-size: cover;
}

.leader-background-artwork {
    left: -8px;
    right: -8px;
    top: -8px;
    bottom: -8px;
    opacity: 0.72;
    transform-origin: center;
}

.leader-ambient-light {
    opacity: 0;
}

.leader-surface-texture {
    opacity: 0.012;
    background-repeat: repeat;
    background-size: 720px 720px;
}

.leader-foreground-overlay {
    opacity: 0.12;
    background-size: contain;
}

/* Header */
.leader-header {
    min-height: 100px;
    flex-shrink: 0;
    justify-content: center;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.07);
}

.leader-header-content {
    width: 100%;
    max-width: 2180px;
    height: 100%;
    align-self: center;
    flex-direction: row;
    align-items: center;
    padding-left: 3.2%;
    padding-right: 3.2%;
}

.leader-country-identity {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.leader-emblem {
    width: 58px;
    height: 58px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    opacity: 0.64;
    background-repeat: no-repeat;
    background-position: center;
    background-size: contain;
}

.leader-emblem-fallback {
    width: 46px;
    height: 46px;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.2);
    border-right-color: rgba(255, 255, 255, 0.2);
    border-top-color: rgba(255, 255, 255, 0.2);
    border-bottom-color: rgba(255, 255, 255, 0.2);
    font-size: 10px;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.leader-country-copy {
    margin-left: 18px;
}

.leader-country-name {
    font-size: 27px;
    letter-spacing: 4px;
    -unity-font-style: bold;
}

.leader-country-meta {
    margin-top: 5px;
    font-size: 10px;
    letter-spacing: 1.7px;
    opacity: 0.92;
}

.leader-country-rule {
    height: 1px;
    flex-grow: 1;
    margin-left: 34px;
    margin-right: 34px;
    opacity: 0.44;
}

.back-button {
    height: 44px;
    min-width: 184px;
    flex-shrink: 0;
    padding-left: 14px;
    padding-right: 14px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 1px;
    border-radius: 0;
    font-size: 12px;
    letter-spacing: 1.8px;
    opacity: 1;
    -unity-font-style: bold;
    transition-property: opacity, scale, translate;
    transition-duration: 170ms;
    transition-timing-function: ease-out;
}

.back-button:hover {
    opacity: 0.82;
    translate: -3px 0;
}

.back-button:active {
    opacity: 0.64;
    scale: 0.986;
    translate: -1px 1px;
}

/* Main composition */
.leader-stage {
    width: 100%;
    max-width: 2180px;
    flex-grow: 1;
    min-height: 0;
    align-self: center;
    flex-direction: row;
    padding-left: 3.2%;
    padding-right: 3.2%;
    padding-top: 18px;
    padding-bottom: 28px;
}

/* Hero portrait */
.leader-visual-column {
    width: 38%;
    min-width: 540px;
    max-width: 780px;
    height: 100%;
    margin-right: 28px;
}

.portrait-stage {
    position: relative;
    flex-grow: 1;
    min-height: 720px;
    overflow: hidden;
    background-color: rgba(1, 4, 7, 0.08);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
}

.portrait-artwork,
.portrait-frame,
.portrait-ornament {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-repeat: no-repeat;
}

.portrait-artwork {
    background-size: contain;
    background-position: center bottom;
    opacity: 0;
    translate: 0 8px;
    transition-property: opacity, translate;
    transition-duration: 360ms;
    transition-timing-function: ease-out;
}

.portrait-artwork--visible {
    opacity: 1;
    translate: 0 0;
}

.portrait-frame {
    margin: 6px;
    background-size: contain;
    background-position: center;
    opacity: 0.42;
}

.portrait-ornament {
    left: 22%;
    right: 22%;
    top: 13%;
    bottom: 24%;
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    opacity: 0.08;
}

.portrait-monogram {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 25%;
    align-items: center;
    justify-content: center;
    font-size: 112px;
    letter-spacing: 14px;
    opacity: 0.42;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

/* Leader identity */
.leader-identity {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 45%;
    min-height: 280px;
    justify-content: flex-end;
}

.leader-identity-gradient {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.leader-identity-copy {
    padding-left: 42px;
    padding-right: 42px;
    padding-bottom: 38px;
}

.leader-function {
    font-size: 10px;
    letter-spacing: 3.4px;
    opacity: 0.86;
    -unity-font-style: bold;
}

.leader-name {
    margin-top: 10px;
    font-size: 42px;
    letter-spacing: 1.5px;
    white-space: normal;
    -unity-font-style: bold;
}

.leader-title {
    margin-top: 8px;
    font-size: 15px;
    letter-spacing: 0.8px;
    opacity: 0.94;
}

/* Editorial information panel */
.leader-editorial-panel {
    position: relative;
    flex-grow: 1;
    min-width: 0;
    height: 100%;
    min-height: 720px;
    overflow: hidden;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
}

.leader-editorial-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.leader-editorial-content {
    flex-grow: 1;
    justify-content: space-between;
    padding-left: 34px;
    padding-right: 34px;
    padding-top: 30px;
    padding-bottom: 28px;
}

.leader-stats-section {
    flex-shrink: 0;
}

.leader-skills-section {
    flex-grow: 1;
    justify-content: flex-end;
    margin-top: 24px;
}

.editorial-heading {
    min-height: 58px;
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
}

.eyebrow {
    font-size: 10px;
    letter-spacing: 2px;
    -unity-font-style: bold;
}

.editorial-title {
    margin-top: 7px;
    font-size: 29px;
    letter-spacing: 0.7px;
    -unity-font-style: bold;
}

.editorial-index {
    margin-top: 2px;
    font-size: 8px;
    letter-spacing: 1.8px;
    opacity: 0.64;
}

.editorial-divider {
    width: 100%;
    height: 1px;
    margin-top: 9px;
    opacity: 0.52;
}

/* Stats */
.stats-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    padding-top: 2px;
}

.stat-row {
    width: 48%;
    min-height: 45px;
    margin-top: 18px;
    flex-direction: row;
    align-items: center;
}

.stat-icon-frame {
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    margin-right: 14px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-radius: 50%;
}

.stat-icon {
    font-size: 14px;
    -unity-text-align: middle-center;
}

.stat-body {
    flex-grow: 1;
    min-width: 0;
}

.stat-heading {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 9px;
}

.stat-name {
    font-size: 10px;
    letter-spacing: 1.8px;
    opacity: 0.94;
}

.stat-value {
    font-size: 16px;
    opacity: 1;
    -unity-font-style: bold;
}

.stat-track {
    height: 2px;
    background-color: rgba(255, 255, 255, 0.12);
}

.stat-fill {
    height: 2px;
}

/* Skills */
.leader-skill-grid {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 18px;
}

.leader-skill-card {
    position: relative;
    width: 23.8%;
    min-height: 248px;
    align-items: stretch;
    padding: 8px;
    overflow: hidden;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-radius: 0;
    transition-property: scale, opacity, background-color, border-left-color, border-right-color, border-top-color, border-bottom-color;
    transition-duration: 180ms;
    transition-timing-function: ease-out;
}

.leader-skill-card--hovered {
    scale: 1.008;
}

.leader-skill-card--selected {
    scale: 1.004;
}

.leader-skill-card:active {
    scale: 0.994;
    opacity: 0.84;
}

.leader-skill-card--locked {
    opacity: 0.72;
}

.leader-skill-card--locked:hover {
    scale: 1;
}

.skill-artwork {
    position: relative;
    height: 142px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    margin-bottom: 10px;
    background-repeat: no-repeat;
    background-position: center;
    background-size: cover;
}

.skill-artwork-shade {
    position: absolute;
    left: 0;
    right: 0;
    top: 34%;
    bottom: 0;
}

.skill-artwork-copy {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding-left: 10px;
    padding-right: 10px;
    padding-bottom: 9px;
}

.skill-artwork-placeholder {
    font-size: 28px;
    opacity: 0.5;
    -unity-text-align: middle-center;
}

.skill-card-name {
    min-height: 31px;
    font-size: 13px;
    letter-spacing: 0.5px;
    white-space: normal;
    -unity-font-style: bold;
}

.skill-card-header {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 5px;
}

.skill-type,
.skill-state {
    font-size: 7px;
    letter-spacing: 0.9px;
    opacity: 0.9;
}

.skill-description {
    height: 34px;
    margin-left: 4px;
    margin-right: 4px;
    font-size: 9px;
    white-space: normal;
    overflow: hidden;
    opacity: 0.8;
}

.skill-accent-line {
    width: 30px;
    height: 1px;
    margin-left: 4px;
    margin-top: 8px;
    transition-property: width, background-color;
    transition-duration: 180ms;
    transition-timing-function: ease-out;
}

.leader-skill-card--hovered .skill-accent-line {
    width: 48px;
}

.leader-skill-card--selected .skill-accent-line {
    width: 70%;
}

/* Compact desktop */
.compact .leader-header {
    min-height: 86px;
}

.compact .leader-header-content {
    padding-left: 2.4%;
    padding-right: 2.4%;
}

.compact .leader-emblem {
    width: 48px;
    height: 48px;
}

.compact .leader-country-copy {
    margin-left: 14px;
}

.compact .leader-country-name {
    font-size: 22px;
}

.compact .leader-country-meta {
    font-size: 9px;
    letter-spacing: 1.3px;
}

.compact .leader-country-rule {
    margin-left: 20px;
    margin-right: 20px;
}

.compact .back-button {
    min-width: 164px;
    font-size: 11px;
}

.compact .leader-stage {
    padding-left: 2.4%;
    padding-right: 2.4%;
    padding-top: 12px;
    padding-bottom: 18px;
}

.compact .leader-visual-column {
    width: 37%;
    min-width: 430px;
    max-width: 600px;
    margin-right: 18px;
}

.compact .portrait-stage,
.compact .leader-editorial-panel {
    min-height: 640px;
}

.compact .leader-identity {
    min-height: 240px;
}

.compact .leader-identity-copy {
    padding-left: 30px;
    padding-right: 30px;
    padding-bottom: 28px;
}

.compact .leader-name {
    font-size: 34px;
}

.compact .leader-editorial-content {
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 22px;
    padding-bottom: 20px;
}

.compact .editorial-title {
    font-size: 25px;
}

.compact .stat-row {
    margin-top: 14px;
}

.compact .stat-icon-frame {
    width: 30px;
    height: 30px;
    margin-right: 10px;
}

.compact .leader-skills-section {
    margin-top: 16px;
}

.compact .leader-skill-card {
    min-height: 220px;
    padding: 7px;
}

.compact .skill-artwork {
    height: 102px;
}

.compact .skill-card-name {
    font-size: 11px;
}

.compact .skill-description {
    height: 30px;
    font-size: 8px;
}
